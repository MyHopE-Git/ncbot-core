  "ปลุก จอ": [
    "const holdMs = 3000;",
    "const cdp = await createCdp(page);",
    "",
    "try {",
    "  const size = await page.evaluate(() => ({",
    "    w: window.innerWidth,",
    "    h: window.innerHeight",
    "  }));",
    "",
    "  const cx = Math.round(size.w / 2);",
    "  const cy = Math.round(size.h / 2);",
    "",
    "  await cdp.send('Input.dispatchMouseEvent', {",
    "    type: 'mouseMoved',",
    "    x: cx,",
    "    y: cy,",
    "    button: 'none'",
    "  });",
    "",
    "  const t0 = Date.now();",
    "  await cdp.send('Input.dispatchMouseEvent', {",
    "    type: 'mousePressed',",
    "    x: cx,",
    "    y: cy,",
    "    button: 'left',",
    "    buttons: 1,",
    "    clickCount: 1",
    "  });",
    "",
    "  await page.waitForTimeout(holdMs);",
    "",
    "  const t1 = Date.now();",
    "  await cdp.send('Input.dispatchMouseEvent', {",
    "    type: 'mouseReleased',",
    "    x: cx,",
    "    y: cy,",
    "    button: 'left',",
    "    buttons: 0,",
    "    clickCount: 1",
    "  });",
    "",
    "  console.log(`Wake done at (${cx}, ${cy}) | elapsed: ${t1 - t0}ms`);",
    "} finally {",
    "  await cdp.detach().catch(() => {});",
    "}"
  ],
  "ปลุก จอ 2": [
    "const holdMs = 3000;",
    "",
    "// ดึงขนาดหน้าจอ (Viewport) ของ Playwright",
    "const size = page.viewportSize() || await page.evaluate(() => ({",
    "  width: window.innerWidth,",
    "  height: window.innerHeight",
    "}));",
    "",
    "const cx = Math.round(size.width / 2);",
    "const cy = Math.round(size.height / 2);",
    "",
    "// เลื่อนเมาส์ไปตรงกลางจอ",
    "await page.mouse.move(cx, cy);",
    "",
    "const t0 = Date.now();",
    "// กดเมาส์ซ้ายค้างไว้",
    "await page.mouse.down({ button: 'left' });",
    "",
    "// รอตามเวลาที่กำหนด (3000ms)",
    "await page.waitForTimeout(holdMs);",
    "",
    "const t1 = Date.now();",
    "// ปล่อยเมาส์ซ้าย",
    "await page.mouse.up({ button: 'left' });",
    "",
    "console.log(`Wake done at (${cx}, ${cy}) | elapsed: ${t1 - t0}ms`);"
  ],
  "WASD": [
    "const code = 'KeyW';",
    "const ms = 1000;",
    "",
    "await page.keyboard.down(code);",
    "try {",
    "  await page.waitForTimeout(ms);",
    "} finally {",
    "  await page.keyboard.up(code);",
    "}",
    "",
    "console.log(`Walk WASD done (${code}, ${ms}ms)`);"
  ],
  "เช็ค นน": [
    "async function wakeScreenLocal(holdMs = 3000) {",
    "  const cdp = await createCdp(page);",
    "  try {",
    "    const size = await page.evaluate(() => ({",
    "      w: window.innerWidth,",
    "      h: window.innerHeight",
    "    }));",
    "    const cx = Math.round(size.w / 2);",
    "    const cy = Math.round(size.h / 2);",
    "",
    "    await cdp.send('Input.dispatchMouseEvent', { type: 'mouseMoved', x: cx, y: cy, button: 'none' });",
    "    await cdp.send('Input.dispatchMouseEvent', { type: 'mousePressed', x: cx, y: cy, button: 'left', buttons: 1, clickCount: 1 });",
    "    await page.waitForTimeout(holdMs);",
    "    await cdp.send('Input.dispatchMouseEvent', { type: 'mouseReleased', x: cx, y: cy, button: 'left', buttons: 0, clickCount: 1 });",
    "    console.log(`Wake done at (${cx}, ${cy})`);",
    "  } finally {",
    "    await cdp.detach().catch(() => {});",
    "  }",
    "}",
    "",
    "async function readWeightFromDOM() {",
    "  return await page.evaluate(() => {",
    "    const text = document.body.innerText || '';",
    "    const m = text.match(/น้ำหนัก\\s*(\\d+(?:\\.\\d+)?)%\\s*([\\d,]+)\\s*\\/\\s*([\\d,]+)/);",
    "    if (!m) return null;",
    "    return {",
    "      percent: parseFloat(m[1]),",
    "      current: parseInt(m[2].replace(/,/g, ''), 10),",
    "      max: parseInt(m[3].replace(/,/g, ''), 10),",
    "      raw: m[0]",
    "    };",
    "  });",
    "}",
    "",
    "async function getWeight({ toggleKey = 'i', waitMs = 300, wakeHoldMs = 3000 } = {}) {",
    "  let w = await readWeightFromDOM();",
    "  if (w) return w;",
    "",
    "  await page.keyboard.press(toggleKey);",
    "  await page.waitForTimeout(waitMs);",
    "  w = await readWeightFromDOM();",
    "  if (w) {",
    "    await page.keyboard.press(toggleKey);",
    "    await page.waitForTimeout(100);",
    "    return w;",
    "  }",
    "",
    "  console.log('Weight not visible -> waking screen and retrying...');",
    "  await wakeScreenLocal(wakeHoldMs);",
    "  await page.waitForTimeout(400);",
    "",
    "  await page.keyboard.press(toggleKey);",
    "  await page.waitForTimeout(waitMs);",
    "  w = await readWeightFromDOM();",
    "",
    "  await page.keyboard.press(toggleKey);",
    "  await page.waitForTimeout(100);",
    "  return w;",
    "}",
    "",
    "const w = await getWeight({ toggleKey: 'i', waitMs: 300, wakeHoldMs: 3000 });",
    "console.log('Weight info:', w);",
    "if (w && w.percent >= 80) {",
    "  console.log('น้ำหนักเกินเกณฑ์ เตรียมกลับเมืองขายของ');",
    "}"
  ],
  "เช็ค นน2": [
    "async function wakeScreenLocal(page, holdMs = 3000) {",
    "  const cdp = await page.context().newCDPSession(page);",
    "  try {",
    "    const size = await page.evaluate(() => ({",
    "      w: window.innerWidth,",
    "      h: window.innerHeight",
    "    }));",
    "    const cx = Math.round(size.w / 2);",
    "    const cy = Math.round(size.h / 2);",
    "",
    "    await cdp.send('Input.dispatchMouseEvent', {",
    "      type: 'mouseMoved',",
    "      x: cx,",
    "      y: cy,",
    "      button: 'none'",
    "    });",
    "    await cdp.send('Input.dispatchMouseEvent', {",
    "      type: 'mousePressed',",
    "      x: cx,",
    "      y: cy,",
    "      button: 'left',",
    "      buttons: 1,",
    "      clickCount: 1",
    "    });",
    "    await page.waitForTimeout(holdMs);",
    "    await cdp.send('Input.dispatchMouseEvent', {",
    "      type: 'mouseReleased',",
    "      x: cx,",
    "      y: cy,",
    "      button: 'left',",
    "      buttons: 0,",
    "      clickCount: 1",
    "    });",
    "    console.log(`Wake done at (${cx}, ${cy})`);",
    "  } finally {",
    "    await cdp.detach().catch(() => {});",
    "  }",
    "}",
    "",
    "async function readWeightFromDOM(page) {",
    "  return await page.evaluate(() => {",
    "    const text = document.body.innerText || '';",
    "    const m = text.match(/น้ำหนัก\\s*(\\d+(?:\\.\\d+)?)%\\s*([\\d,]+)\\s*\\/\\s*([\\d,]+)/);",
    "    if (!m) return null;",
    "    return {",
    "      percent: parseFloat(m[1]),",
    "      current: parseInt(m[2].replace(/,/g, ''), 10),",
    "      max: parseInt(m[3].replace(/,/g, ''), 10),",
    "      raw: m[0]",
    "    };",
    "  });",
    "}",
    "",
    "async function getWeight(page, { toggleKey = 'i', waitMs = 300, wakeHoldMs = 3000 } = {}) {",
    "  let w = await readWeightFromDOM(page);",
    "  if (w) return w;",
    "",
    "  await page.keyboard.press(toggleKey);",
    "  await page.waitForTimeout(waitMs);",
    "  w = await readWeightFromDOM(page);",
    "  if (w) {",
    "    await page.keyboard.press(toggleKey);",
    "    await page.waitForTimeout(100);",
    "    return w;",
    "  }",
    "",
    "  console.log('Weight not visible -> waking screen and retrying...');",
    "  await wakeScreenLocal(page, wakeHoldMs);",
    "  await page.waitForTimeout(400);",
    "",
    "  await page.keyboard.press(toggleKey);",
    "  await page.waitForTimeout(waitMs);",
    "  w = await readWeightFromDOM(page);",
    "",
    "  await page.keyboard.press(toggleKey);",
    "  await page.waitForTimeout(100);",
    "  return w;",
    "}",
    "",
    "// ตัวอย่างการเรียกใช้งาน (สมมติว่ามีตัวแปร `page` อยู่แล้ว)",
    "const w = await getWeight(page, { toggleKey: 'i', waitMs: 300, wakeHoldMs: 3000 });",
    "console.log('Weight info:', w);",
    "if (w && w.percent >= 80) {",
    "  console.log('น้ำหนักเกินเกณฑ์ เตรียมกลับเมืองขายของ');",
    "}"
  ],
  "คลิกขวาเดินอิงจากกลางจอ": [
    "const offsetX = 120;",
    "const holdMs = 150;",
    "const cdp = await createCdp(page);",
    "",
    "try {",
    "  const size = await page.evaluate(() => ({",
    "    w: window.innerWidth,",
    "    h: window.innerHeight",
    "  }));",
    "",
    "  const cx = Math.round(size.w / 2);",
    "  const cy = Math.round(size.h / 2);",
    "  const tx = Math.max(10, Math.min(size.w - 10, cx + offsetX));",
    "  const ty = cy;",
    "",
    "  await cdp.send('Input.dispatchMouseEvent', {",
    "    type: 'mouseMoved',",
    "    x: tx,",
    "    y: ty,",
    "    button: 'none'",
    "  });",
    "",
    "  const t0 = Date.now();",
    "  await cdp.send('Input.dispatchMouseEvent', {",
    "    type: 'mousePressed',",
    "    x: tx,",
    "    y: ty,",
    "    button: 'right',",
    "    buttons: 2,",
    "    clickCount: 1",
    "  });",
    "",
    "  if (holdMs > 0) {",
    "    await page.waitForTimeout(holdMs);",
    "  }",
    "",
    "  const t1 = Date.now();",
    "  await cdp.send('Input.dispatchMouseEvent', {",
    "    type: 'mouseReleased',",
    "    x: tx,",
    "    y: ty,",
    "    button: 'right',",
    "    buttons: 0,",
    "    clickCount: 1",
    "  });",
    "",
    "  console.log(`Right click at (${tx}, ${ty}) | elapsed: ${t1 - t0}ms`);",
    "} finally {",
    "  await cdp.detach().catch(() => {});",
    "}"
  ],
